PORT=3000

# Personal Telegram assistant
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USER_ID=
TELEGRAM_OWNER_ID=
BOT_ENABLED=false
BOT_DRY_RUN=true

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1600

# Redis
REDIS_URL=
REDIS_REQUIRED=true
REDIS_NAMESPACE=astel:tg:v1
DEDUPE_TTL_SECONDS=86400
RESERVATION_TTL_SECONDS=300
PUBLICATION_TTL_SECONDS=86400
REDIS_CONNECT_TIMEOUT_MS=5000
HEALTH_HEARTBEAT_TTL_SECONDS=30

# Safety / memory
NORMAL_REPLY_LIMIT=3
COOLDOWN_SECONDS=2
CONVERSATION_RESET_HOURS=24
MEMORY_MAX_MESSAGES=12
MEMORY_MAX_TOKENS=3000
GLOBAL_DAILY_LIMIT=50
HUMAN_LOCK_TTL_HOURS=24
